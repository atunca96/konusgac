{
  "name": "konusgac",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "Konuşgaç: sunucular, kanallar, DM ve rollerle gerçek zamanlı sohbet uygulaması",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev -w @konusgac/server\" \"npm:dev -w @konusgac/web\"",
    "build": "npm run build -w @konusgac/web",
    "start": "npm run start -w @konusgac/server",
    "desktop": "npm run start -w @konusgac/desktop",
    "test": "npm run test -w @konusgac/server",
    "typecheck": "npm run typecheck -w @konusgac/server && npm run typecheck -w @konusgac/web",
    "dist:desktop": "npm run dist -w @konusgac/desktop",
    "test:voice": "npm run test:voice -w @konusgac/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://konusgac.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/atunca96/konusgac.git"
  },
  "bugs": {
    "url": "https://github.com/atunca96/konusgac/issues"
  },
  "allowScripts": {
    "mediasoup@3.30.1": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
